VITE_API_BASE_URL=/api
# For a separately hosted frontend, use the backend URL reachable by browsers:
# VITE_API_BASE_URL=http://192.168.1.10:4000/api
# Enables visible route-navigation test mode during `vite` development only.
# It is ignored by production builds and does not bypass backend authorization.
VITE_AEGIS_TEST_MODE=false
